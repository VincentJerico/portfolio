# Copy to .env.cli and fill in. .env.cli is gitignored; never commit it.
# Vercel only: this site has no database.

# Personal account token (not a team/work scope): vercel.com/account/tokens
VERCEL_TOKEN=

# From .vercel/project.json after `pnpm vercel:link`, or Project Settings.
# Setting both lets the CLI skip project linking entirely.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
