{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contrast": "tsx scripts/contrast-report.ts",
    "vercel:link": "dotenv -e .env.cli -- sh -c 'vercel link --yes --project vincentjerico --token \"$VERCEL_TOKEN\"'",
    "vercel:whoami": "dotenv -e .env.cli -- sh -c 'vercel whoami --token \"$VERCEL_TOKEN\"'",
    "deploy:preview": "dotenv -e .env.cli -- bash scripts/vercel-deploy.sh preview",
    "deploy:prod": "dotenv -e .env.cli -- bash scripts/vercel-deploy.sh production",
    "content:report": "tsx scripts/content-report.ts",
    "cv": "tsx scripts/build-cv-pdf.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.5",
    "@types/mdx": "^2.0.14",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "axe-core": "^4.14.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vercel": "^65.12.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22 <23"
  }
}
