{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contrast": "tsx scripts/contrast-report.ts",
    "vercel:link": "dotenv -e .env.cli -- sh -c 'vercel link --yes --token \"$VERCEL_TOKEN\"'",
    "vercel:whoami": "dotenv -e .env.cli -- sh -c 'vercel whoami --token \"$VERCEL_TOKEN\"'",
    "deploy:preview": "dotenv -e .env.cli -- sh -c 'vercel deploy --token \"$VERCEL_TOKEN\"'",
    "deploy:prod": "dotenv -e .env.cli -- sh -c 'vercel deploy --prod --token \"$VERCEL_TOKEN\"'",
    "content:report": "tsx scripts/content-report.ts",
    "cv": "tsx scripts/build-cv-pdf.ts"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^65.2.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22 <23"
  }
}
