# Copy to .env.local for local development. See spec Section 11.

# Required. Canonical site origin, e.g. https://vincentjerico.dev or the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Contact form (server only). The form is hidden unless all four are set. KV_REST_API_URL and
# KV_REST_API_TOKEN (the Vercel KV integration's names) work in place of the two UPSTASH_ variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. HMAC key for the rate-limit keys, so Upstash never sees a raw IP. Derived from the Redis
# token when unset.
CONTACT_KEY_SALT=

# Optional. Fine-grained, public repositories read-only. Server only.
GH_DATA_TOKEN=
