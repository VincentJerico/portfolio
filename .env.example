# Copy to .env.local for local development. See spec Section 11.

# Required. Canonical site origin, e.g. https://vincentjerico.dev or the Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Contact form (server only). The form is hidden unless all four are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Fine-grained, public repositories read-only. Server only.
GH_DATA_TOKEN=
